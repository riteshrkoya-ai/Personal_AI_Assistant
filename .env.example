APP_NAME=AI Personal Assistant
APP_ENV=local

DATABASE_URL=postgresql+asyncpg://assistant_user:assistant_password@postgres:5432/assistant_db

# LLM provider options:
# Local Docker: ollama
# Render cloud: gemini
LLM_PROVIDER=ollama

# Local Ollama settings
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b

# Gemini settings for Render/cloud deployment
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

TELEGRAM_BOT_TOKEN=
AUTHORIZED_TELEGRAM_CHAT_IDS=
API_BASE_URL=http://api:8000

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
MEMORY_SEARCH_TOP_K=5

TIMEZONE=America/New_York