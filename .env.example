APP_NAME=AI Personal Assistant
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000

DATABASE_URL=postgresql+asyncpg://assistant_user:assistant_password@postgres:5432/assistant_db

# Local LLM defaults. Leave LLM_MODEL blank/unset locally to keep using Ollama.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
LLM_MODEL=

# Cloud LLM credentials. Normally blank locally and set only in Render.
GEMINI_API_KEY=
GROQ_API_KEY=

TELEGRAM_BOT_TOKEN=
AUTHORIZED_TELEGRAM_CHAT_IDS=
API_BASE_URL=http://api:8000

TIMEZONE=America/New_York

EMBEDDING_BACKEND=sentence_transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
MEMORY_SEARCH_TOP_K=5